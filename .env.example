# Configuración de Supabase para TaskFlow.
# 1. Copia este archivo y renómbralo a ".env.local" (ese archivo NO se sube a GitHub).
# 2. Completa los valores desde Supabase > Project Settings > API.
# 3. Reinicia la app (npm run dev).

# Dirección del proyecto, por ejemplo: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clave pública (publishable key, empieza con "sb_publishable_").
# NUNCA pongas aquí la clave secreta (secret / service_role).
VITE_SUPABASE_PUBLISHABLE_KEY=
